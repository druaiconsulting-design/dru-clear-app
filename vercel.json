{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "functions": {
    "api/ghl-agent-trigger.ts": {
      "maxDuration": 300
    },
    "api/cc-agent-trigger.ts": {
      "maxDuration": 60
    },
    "api/send-notification.ts": {
      "maxDuration": 30
    },
    "api/social-response-trigger.ts": {
      "maxDuration": 30
    },
    "api/social-reply-publisher.ts": {
      "maxDuration": 30
    },
    "api/sd-report-approve.ts": {
      "maxDuration": 300
    },
    "api/course-deck-pdf.ts": {
      "maxDuration": 120
    },
    "api/course-deck-picture.ts": {
      "maxDuration": 120
    },
    "api/ryan-crm-report.ts": {
      "maxDuration": 300
    },
    "api/ryan-apply.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "empire.druaiconsulting.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/jaylen-nonmember-signup",
      "has": [
        {
          "type": "host",
          "value": "subscribe.druaiconsulting.com"
        }
      ],
      "destination": "/api/jaylen-nonmember-signup"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "subscribe.druaiconsulting.com"
        }
      ],
      "destination": "/api/newsletter-subscribe"
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "subscribe.druaiconsulting.com"
        }
      ],
      "destination": "/subscribe-not-found"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "empire.druaiconsulting.com"
        }
      ],
      "destination": "/empire-robots.txt"
    },
    {
      "source": "/admin-launch.html",
      "destination": "/admin-launch.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
