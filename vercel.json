{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
"installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "assessment.druaiconsulting.com"
        }
      ],
      "destination": "https://app.druaiconsulting.com/$1",
      "permanent": true
    }
  ]
}
